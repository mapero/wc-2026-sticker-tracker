{
  "name": "world-cup-2026-stickers",
  "version": "1.0.0",
  "private": true,
  "description": "Panini FIFA World Cup 2026 sticker album collection tracker",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run check:i18n && vue-tsc --noEmit && vite build",
    "typecheck": "vue-tsc --noEmit",
    "check:i18n": "node scripts/check-i18n.mjs",
    "preview": "vite preview",
    "lint": "eslint \"src/**/*.{js,ts,vue}\" --cache --max-warnings 0",
    "lint:fix": "eslint \"src/**/*.{js,ts,vue}\" --cache --fix"
  },
  "dependencies": {
    "lucide-vue-next": "^1.0.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-i18n": "^11.4.20",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.72.2",
    "@typescript-eslint/parser": "^8.72.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import-x": "^4.18.1",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~6.0.3",
    "vite": "^8.3.8",
    "vue-eslint-parser": "^10.4.2",
    "vue-tsc": "^3.3.14"
  }
}
